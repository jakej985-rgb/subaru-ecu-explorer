{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakej985-rgb/subaru-ecu-explorer/blob/main/schemas/engine-config.schema.json",
  "title": "Subaru ECU Explorer Engine Configuration",
  "description": "Versioned engine configuration document. Unverified attributes remain explicit unknown facts; nothing is inferred silently.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "make", "family", "displacementLiters", "cylinders", "aspiration", "fuelSystem", "valvetrain"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "make": { "$ref": "#/$defs/stringFact" },
    "family": { "$ref": "#/$defs/stringFact" },
    "displacementLiters": {
      "allOf": [
        { "$ref": "#/$defs/numberFact" },
        { "type": "object", "properties": { "value": { "type": "number", "exclusiveMinimum": 0 } } }
      ]
    },
    "cylinders": {
      "allOf": [
        { "$ref": "#/$defs/integerFact" },
        { "type": "object", "properties": { "value": { "type": "integer", "minimum": 1, "maximum": 16 } } }
      ]
    },
    "aspiration": { "$ref": "#/$defs/stringFact" },
    "fuelSystem": { "$ref": "#/$defs/stringFact" },
    "valvetrain": { "$ref": "#/$defs/stringFact" },
    "production": { "$ref": "#/$defs/productionFact" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "reference": { "type": "string" }
      }
    },
    "factBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["confirmed", "inferred", "unknown", "unsupported"] },
        "value": {},
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["confirmed", "inferred"] } }, "required": ["status"] },
          "then": {
            "required": ["value", "evidence"],
            "properties": { "evidence": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["unknown", "unsupported"] } }, "required": ["status"] },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "stringFact": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        {
          "type": "object",
          "properties": { "value": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "numberFact": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        {
          "type": "object",
          "properties": { "value": { "type": "number" } }
        }
      ]
    },
    "integerFact": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        {
          "type": "object",
          "properties": { "value": { "type": "integer" } }
        }
      ]
    },
    "productionRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "productionFact": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        { "type": "object", "properties": { "value": { "$ref": "#/$defs/productionRange" } } }
      ]
    }
  }
}
