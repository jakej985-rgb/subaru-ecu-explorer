{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakej985-rgb/subaru-ecu-explorer/blob/main/schemas/hardware-profile.schema.json",
  "title": "Subaru ECU Explorer Hardware Profile",
  "description": "Versioned ECU/module hardware reference data. Describes a known hardware variant; never claims what is installed in a vehicle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "kind", "manufacturer", "partNumber"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["engine-ecu", "abs-controller", "abs-hydraulic-assembly", "transmission-controller", "other-module"] },
    "manufacturer": { "$ref": "#/$defs/stringFact" },
    "partNumber": { "$ref": "#/$defs/stringFact" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "reference": { "type": "string" }
      }
    },
    "factBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["confirmed", "inferred", "unknown", "unsupported"] },
        "value": {},
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["confirmed", "inferred"] } }, "required": ["status"] },
          "then": {
            "required": ["value", "evidence"],
            "properties": { "evidence": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["unknown", "unsupported"] } }, "required": ["status"] },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "stringFact": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        {
          "type": "object",
          "properties": { "value": { "type": "string", "minLength": 1 } }
        }
      ]
    }
  }
}
