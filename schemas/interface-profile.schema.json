{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakej985-rgb/subaru-ecu-explorer/blob/main/schemas/interface-profile.schema.json",
  "title": "Subaru ECU Explorer Diagnostic Interface Profile",
  "description": "Versioned diagnostic interface/adapter path description. Interface compatibility is a communication path, not installed vehicle hardware, and never implies module fitment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "kind", "transport", "protocol", "readOnly"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["elm327-odbii", "subaru-ssm", "arduino-serial"] },
    "transport": { "$ref": "#/$defs/stringFact" },
    "protocol": { "$ref": "#/$defs/stringFact" },
    "readOnly": { "$ref": "#/$defs/boolFact" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "reference": { "type": "string" }
      }
    },
    "factBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["confirmed", "inferred", "unknown", "unsupported"] },
        "value": {},
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["confirmed", "inferred"] } }, "required": ["status"] },
          "then": {
            "required": ["value", "evidence"],
            "properties": { "evidence": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["unknown", "unsupported"] } }, "required": ["status"] },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "stringFact": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        {
          "type": "object",
          "properties": { "value": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "boolFact": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        {
          "type": "object",
          "properties": { "value": { "type": "boolean" } }
        }
      ]
    }
  }
}
