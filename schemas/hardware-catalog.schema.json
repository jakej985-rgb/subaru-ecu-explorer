{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakej985-rgb/subaru-ecu-explorer/blob/main/schemas/hardware-catalog.schema.json",
  "title": "Subaru ECU Explorer Hardware Compatibility Catalog",
  "description": "Versioned catalog linking vehicle configurations to candidate ECU/module hardware with evidence tiers. Candidates are never presented as installed hardware.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/catalogEntry" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "reference": { "type": "string" }
      }
    },
    "factBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["confirmed", "inferred", "unknown", "unsupported"] },
        "value": {},
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["confirmed", "inferred"] } }, "required": ["status"] },
          "then": {
            "required": ["value", "evidence"],
            "properties": { "evidence": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["unknown", "unsupported"] } }, "required": ["status"] },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "stringFact": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        {
          "type": "object",
          "properties": { "value": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "productionRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "productionFact": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        { "type": "object", "properties": { "value": { "$ref": "#/$defs/productionRange" } } }
      ]
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "configuration", "module", "hardware", "tier"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "configuration": { "$ref": "#/$defs/stringFact" },
        "module": { "enum": ["engine-ecu", "abs-controller", "transmission-controller", "other-module"] },
        "hardware": { "$ref": "#/$defs/stringFact" },
        "tier": { "enum": ["confirmed", "corroborated", "candidate", "unresolved"] },
        "applicability": { "$ref": "#/$defs/productionFact" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "tier": { "enum": ["confirmed", "corroborated", "candidate"] } },
            "required": ["tier"]
          },
          "then": {
            "properties": {
              "hardware": {
                "type": "object",
                "properties": {
                  "status": { "enum": ["confirmed", "inferred"] }
                }
              },
              "evidence": { "minItems": 1 }
            },
            "required": ["evidence"]
          }
        },
        {
          "if": {
            "properties": { "tier": { "const": "unresolved" } },
            "required": ["tier"]
          },
          "then": {
            "properties": {
              "hardware": {
                "type": "object",
                "properties": {
                  "status": { "enum": ["unknown", "unsupported"] }
                }
              }
            }
          }
        }
      ]
    }
  }
}
